PROJECT_NAME="RevenueOS AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# Production Security Secrets (Change in Production!)
JWT_SECRET="e9a8f7c6b5a4d3c2b1a0987654321fedcba0987654321fedcba0987654321fed"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Production Database (PostgreSQL with pgvector extension)
DATABASE_URL="postgresql://revenueos_prod_user:SecureProdPassword2026!@postgres-prod.internal:5432/revenueos_prod"

# Redis Cache & Background Queue
REDIS_URL="redis://redis-prod.internal:6379/0"

# Production AI Provider (openai, gemini, anthropic, or mock)
AI_PROVIDER="openai"
AI_API_KEY="sk-prod-your-openai-api-key-here"
AI_MODEL="gpt-4o"

# Production Frontend & CORS Origins
FRONTEND_URL="https://app.revenueos.ai"
BACKEND_URL="https://api.revenueos.ai"
CORS_ORIGINS=["https://app.revenueos.ai","https://admin.revenueos.ai"]

# Production Integrations Credentials
STRIPE_SECRET_KEY="sk_live_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"
SENDGRID_API_KEY="SG.your_sendgrid_api_key"
SLACK_CLIENT_ID="your_slack_client_id"
SLACK_CLIENT_SECRET="your_slack_client_secret"
HUBSPOT_CLIENT_ID="your_hubspot_client_id"
HUBSPOT_CLIENT_SECRET="your_hubspot_client_secret"
SALESFORCE_CLIENT_ID="your_salesforce_client_id"
SALESFORCE_CLIENT_SECRET="your_salesforce_client_secret"
