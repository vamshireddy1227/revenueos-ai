PROJECT_NAME="RevenueOS AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security
JWT_SECRET="super-secret-key-change-in-production-revenueos-2026"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL with pgvector for Prod, SQLite for instant Local Dev)
DATABASE_URL="sqlite:///./revenueos.db"

# Redis
REDIS_URL="redis://localhost:6379/0"

# AI Provider Abstraction (mock, openai, gemini, anthropic)
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL="gpt-4o-mini"

# Frontend CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
